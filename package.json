{
  "name": "ibl-baker-workspace",
  "private": true,
  "scripts": {
    "test": "pnpm run test:rust && pnpm run test:workspace && pnpm run test:cli",
    "test:rust": "cargo test --workspace",
    "test:workspace": "pnpm -r --filter @ibltools/ibla-loader --filter @ibltools/ktx2-loader --filter @ibltools/ibla-viewer --filter @ibltools/ktx2-viewer run test",
    "test:js": "pnpm -r --filter @ibltools/ibla-loader --filter @ibltools/ktx2-loader run test",
    "test:viewers": "pnpm -r --filter @ibltools/ibla-viewer --filter @ibltools/ktx2-viewer run test",
    "test:ibla-viewer": "pnpm --filter @ibltools/ibla-viewer run test",
    "test:ktx2-viewer": "pnpm --filter @ibltools/ktx2-viewer run test",
    "check:rs": "cargo check --workspace",
    "check:pnpm-cargo": "node scripts/check-pnpm-cargo.mjs",
    "check:ts": "tsc -b packages/ibla-loader packages/ktx2-loader packages/ibla-viewer packages/ktx2-viewer --noEmit",
    "dev:ibla-viewer": "pnpm --filter @ibltools/ibla-viewer run dev",
    "dev:ktx2-viewer": "pnpm --filter @ibltools/ktx2-viewer run dev",
    "fixtures:refresh": "node scripts/refresh-fixtures.mjs",
    "release": "node scripts/release/run.mjs",
    "release:check": "node scripts/release/run.mjs static",
    "release:test": "node --test scripts/release/tests/*.test.mjs",
    "release:smoke": "node scripts/release/smoke.mjs",
    "ci:fixtures": "node scripts/ci-fixtures.mjs",
    "release:binary": "node scripts/release/binary.mjs",
    "test:cli": "pnpm --filter @ibltools/cli run test",
    "release:cli-smoke": "node scripts/release/cli-smoke.mjs"
  },
  "devDependencies": {
    "@types/node": "^25.5.2",
    "npm": "11.11.0",
    "smol-toml": "1.8.0",
    "typescript": "^6.0.2"
  },
  "packageManager": "pnpm@12.5.1"
}
